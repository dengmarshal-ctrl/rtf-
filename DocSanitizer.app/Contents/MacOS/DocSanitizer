#!/usr/bin/env bash
set -euo pipefail

APP_EXEC_DIR="$(cd "$(dirname "$0")" && pwd)"
APP_CONTENTS_DIR="$(cd "$APP_EXEC_DIR/.." && pwd)"
PROJECT_DIR="$(cd "$APP_CONTENTS_DIR/../.." && pwd)"
LAUNCH_SCRIPT="$PROJECT_DIR/run_local_macos.command"

if [ ! -f "$LAUNCH_SCRIPT" ]; then
  osascript <<EOF
display alert "启动失败" message "未找到 run_local_macos.command，请确保 .app 和脚本在同一项目目录。" as critical
EOF
  exit 1
fi

chmod +x "$LAUNCH_SCRIPT"

osascript <<EOF
tell application "Terminal"
  activate
  do script "cd \"$PROJECT_DIR\"; ./run_local_macos.command"
end tell
EOF
